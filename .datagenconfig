{
    "builderSettings": {
        "source": "src/",
        "output": "datapacks/",
        "comment": false,
        "allowEmptyLines": false,
        "obfuscate": false,
        "indent": 4
    },
    "dumperSettings": {
        "source": "dumpgen/dumps/",
        "output": "datagen/utils/minecraft/collections/"
    },
    "loggerSettings": {
        "enabled": true,
        "levels": {
            "debug": true,
            "success": true,
            "info": true,
            "warning": true,
            "error": true,
            "task": true
        },
        "whitelist": {
            "enabled": true,
            "values": [
                "testpack",
                "SYSTEM"
            ]
        }
    },
    "environmentSettings": {
        "names": {
            "namespaces": {
                "minecraft": "minecraft",
                "temp": "temp"
            },
            "scoreboard": {
                "temp": "temp"
            },
            "dataStorage": {
                "temp": "temp"
            }
        }
    }
}