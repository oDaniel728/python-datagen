start: directive+

directive: pack_decl
         | ns_decl
         | objective_decl
         | team_decl

pack_decl: ".pack" pack_name pack_format

ns_decl: ".ns" namespace_name

objective_decl: ".objective" objective_name objective_criterion?

team_decl: ".team" team_name team_color team_display

pack_name: STRING
namespace_name: NAME
objective_name: NAME
objective_criterion: NAME
team_name: NAME
team_color: NAME
team_display: STRING
pack_format: INT

STRING: /"[^"]*"/
NAME: /[a-zA-Z_][a-zA-Z0-9_\/\-\.]*/
INT: /\d+/

%ignore /;.*/
%ignore /\s+/
