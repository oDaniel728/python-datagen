{
    "builderSettings": {
        "source": "src/",
        "output": "datapacks/ ",
        "comment": false,
        "allowEmptyLines": false,
        "obfuscation": {
            "enabled": false,
            "where": {
                "identifiers": {
                    "functions": true,
                    "tags": true,
                    "advancements": true,
                    "predicates": true,
                    "loot_tables": true,
                    "data_storages": true
                },
                "other": {
                    "scoreboard": {
                        "objectives": true,
                        "players": true
                    },
                    "entity_teams": true,
                    "entity_tags": true,
                    "item_custom_data_keys": true
                }
            }
        },
        "indent": 4,
        "pack_format": 48
    },
    "dumperSettings": {
        "source": "dumpgen/dumps/",
        "output": "datagen/utils/minecraft/collections/"
    },
    "loggerSettings": {
        "enabled": true,
        "levels": {
            "debug": true,
            "success": true,
            "info": true,
            "warning": true,
            "error": true,
            "task": true
        },
        "whitelist": {
            "enabled": true,
            "values": [
                "testpack",
                "SYSTEM"
            ]
        }
    },
    "environmentSettings": {
        "names": {
            "namespaces": {
                "minecraft": "minecraft",
                "temp": "temp"
            },
            "scoreboard": {
                "temp": "temp"
            },
            "dataStorage": {
                "temp": "temp"
            }
        }
    }
}